{
  "info": {
    "name": "WitMe User App REST APIs (Render Live)",
    "description": "Postman Collection for WitMe User App APIs deployed on Render",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://withmeapi-userapp.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+919876543210\",\n  \"otp_code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone_number\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-otp"]
            }
          }
        },
        {
          "name": "Get Country Codes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/country-codes",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "country-codes"]
            }
          }
        },
        {
          "name": "Terms of Service",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/terms-of-service",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "terms-of-service"]
            }
          }
        },
        {
          "name": "Privacy Policy",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/privacy-policy",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "privacy-policy"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Profile & KYC",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            }
          }
        },
        {
          "name": "Edit Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Sharma\",\n  \"email\": \"alex@example.com\",\n  \"city\": \"Mumbai\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/edit",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "edit"]
            }
          }
        },
        {
          "name": "Submit KYC",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type\": \"PAN_CARD\",\n  \"document_number\": \"ABCDE1234F\",\n  \"full_name\": \"Alex Sharma\",\n  \"dob\": \"1998-05-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kyc/verify",
              "host": ["{{baseUrl}}"],
              "path": ["kyc", "verify"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Aadhaar Verification",
      "item": [
        {
          "name": "Send Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"aadhaar_number\": \"123456789012\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/aadhaar/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["aadhaar", "send-otp"]
            }
          }
        },
        {
          "name": "Verify Aadhaar OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ref_id\": \"adh_ref_123\",\n  \"otp\": \"654321\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/aadhaar/otp-verify",
              "host": ["{{baseUrl}}"],
              "path": ["aadhaar", "otp-verify"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Activities & Explore",
      "item": [
        {
          "name": "Popular Activities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities/popular-activities",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "popular-activities"]
            }
          }
        },
        {
          "name": "Recommended Partners",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities/recommended-partners",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "recommended-partners"]
            }
          }
        },
        {
          "name": "Explore Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/explore",
              "host": ["{{baseUrl}}"],
              "path": ["explore"]
            }
          }
        }
      ]
    }
  ]
}
