{
  "info": {
    "name": "WitMe User App REST APIs (Render Live)",
    "description": "Postman Collection for WitMe User App APIs deployed on Render with 4-digit OTP, getProfile, Interest Selection, and updated Recommended Partners",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://withmeapi-userapp.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send OTP (4-digit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\",\n  \"otp_code\": \"8675\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-otp"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Profile & KYC",
      "item": [
        {
          "name": "getProfile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/getProfile",
              "host": ["{{baseUrl}}"],
              "path": ["getProfile"]
            }
          }
        },
        {
          "name": "Interest Selection",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interested_in_gender\": \"Female\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/interest-selection",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "interest-selection"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Activities & Explore",
      "item": [
        {
          "name": "Recommended Partners (Includes rating, price, age)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/activities/recommended-partners",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "recommended-partners"]
            }
          }
        },
        {
          "name": "Popular Activities",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/activities/popular-activities",
              "host": ["{{baseUrl}}"],
              "path": ["activities", "popular-activities"]
            }
          }
        }
      ]
    }
  ]
}
