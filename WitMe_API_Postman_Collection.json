{
  "info": {
    "name": "WitMe User App REST APIs (Render Live)",
    "description": "Postman Collection for WitMe User App APIs deployed on Render with 4-digit OTP, getProfile, and Interest Selection support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://withmeapi-userapp.onrender.com/api/v1",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Send OTP (4-digit)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\",\n  \"otp_code\": \"8675\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country_code\": \"+91\",\n  \"phone_number\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/resend-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "resend-otp"]
            }
          }
        },
        {
          "name": "Get Country Codes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/auth/country-codes",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "country-codes"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Profile & KYC",
      "item": [
        {
          "name": "getProfile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/getProfile",
              "host": ["{{baseUrl}}"],
              "path": ["getProfile"]
            }
          }
        },
        {
          "name": "Interest Selection (Gender Preference)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"interested_in_gender\": \"Female\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/interest-selection",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "interest-selection"]
            }
          }
        },
        {
          "name": "Edit Profile",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Sharma\",\n  \"email\": \"alex@example.com\",\n  \"city\": \"Mumbai\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile/edit",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "edit"]
            }
          }
        },
        {
          "name": "Submit KYC",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"document_type\": \"PAN_CARD\",\n  \"document_number\": \"ABCDE1234F\",\n  \"full_name\": \"Alex Sharma\",\n  \"dob\": \"1998-05-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/kyc/verify",
              "host": ["{{baseUrl}}"],
              "path": ["kyc", "verify"]
            }
          }
        }
      ]
    }
  ]
}
